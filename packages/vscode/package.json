{
  "name": "meow",
  "displayName": "Meow",
  "description": "Encrypted clipboard between your machines. Share text through a relay you host yourself.",
  "version": "0.1.0",
  "publisher": "aravindbaranitharan",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": { "type": "git", "url": "https://github.com/AravindBaranitharan/copyme" },
  "bugs": { "url": "https://github.com/AravindBaranitharan/copyme/issues" },
  "homepage": "https://copyme.aravindbaranitharan.in",
  "galleryBanner": { "color": "#06070A", "theme": "dark" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "keywords": ["clipboard", "encrypted", "sync", "remote", "share"],
  "browser": "./dist/web/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": { "supported": true },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      { "command": "meow.connect", "title": "Connect to a Channel", "category": "Meow" },
      { "command": "meow.disconnect", "title": "Disconnect", "category": "Meow" },
      { "command": "meow.sendSelection", "title": "Send Selection", "category": "Meow" },
      { "command": "meow.sendClipboard", "title": "Send Clipboard", "category": "Meow" },
      { "command": "meow.copyLatest", "title": "Copy Latest to Clipboard", "category": "Meow" },
      { "command": "meow.insertLatest", "title": "Insert Latest at Cursor", "category": "Meow" },
      { "command": "meow.history", "title": "Show History", "category": "Meow" },
      { "command": "meow.clearHistory", "title": "Clear Channel History", "category": "Meow" },
      { "command": "meow.showFingerprint", "title": "Show Channel Fingerprint", "category": "Meow" },
      { "command": "meow.setRelayUrl", "title": "Set Relay URL", "category": "Meow" },
      { "command": "meow.testConnection", "title": "Test Connection", "category": "Meow" }
    ],
    "submenus": [{ "id": "meow.menu", "label": "Meow" }],
    "menus": {
      "editor/context": [{ "submenu": "meow.menu", "group": "9_cutcopypaste@100" }],
      "meow.menu": [
        { "command": "meow.sendSelection", "when": "editorHasSelection", "group": "1_send@1" },
        { "command": "meow.sendClipboard", "group": "1_send@2" },
        { "command": "meow.insertLatest", "group": "2_receive@1" },
        { "command": "meow.copyLatest", "group": "2_receive@2" }
      ]
    },
    "configuration": {
      "title": "Meow",
      "properties": {
        "meow.relayUrl": {
          "type": "string",
          "default": "https://copyme-relay.aravindbaranitharan.in",
          "markdownDescription": "Base URL of the CopyMe relay. Must be **https** outside localhost — the extension refuses plaintext http so a channel token cannot cross the network in the clear."
        },
        "meow.warnOnSecrets": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask before sending text that looks like a credential — private keys, cloud access keys, tokens or `.env` assignments. Detection is a heuristic, not a guarantee."
        },
        "meow.confirmLargeSends": {
          "type": "number",
          "default": 100000,
          "markdownDescription": "Ask before sending text longer than this many characters. Set to `0` to never ask."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npm run compile && vsce package --no-dependencies",
    "publish:vsce": "npm run compile && vsce publish --no-dependencies",
    "publish:ovsx": "npm run compile && ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "ovsx": "^0.10.1",
    "typescript": "^5.7.0"
  }
}
